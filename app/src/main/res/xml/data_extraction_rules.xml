<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android's backup or a device-to-device transfer. allowBackup="false" stops cloud backup, but on
     Android 12+ a cable or Wi-Fi transfer to a new phone ignores it and copies an app's data unless these rules say otherwise; that would
     carry learned keyboard words, notification history and the layout to another device, which the settings promise does not happen.
     Moving a layout is the person's choice, through the backup file in General › Backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
