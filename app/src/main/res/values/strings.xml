    <string name="status_reader_service_label">Uno Launcher island alignment</string>
    <string name="status_reader_service_description">Optional. Lets Uno Launcher\'s island line its edges up with the status bar\'s icons on any phone. It reads only where those icons are on screen (their positions), from the status bar alone: never their text, never other apps\' windows. It keeps only the latest positions in memory, takes no actions and sends nothing.</string>
    <string name="status_auto_title">Automatic</string>
    <string name="status_auto_note">With Uno Launcher island alignment turned on in Android\'s accessibility settings, the island reads where the status bar\'s icons really are and keeps its edges between them on any phone, font size or set of icons. It reads only the icons\' positions, never their text, and nothing leaves the phone. The guides below are then not needed.</string>
    <plurals name="status_auto_reading">
        <item quantity="one">On: lining up with %1$d status bar item.</item>
        <item quantity="other">On: lining up with %1$d status bar items.</item>
    </plurals>
    <string name="status_auto_waiting">On: waiting for the status bar to change.</string>
    <string name="status_auto_blocked">Turned on, but Android is not running it (a restricted-settings block can do this).</string>
    <string name="status_auto_off">Off: the island uses the guides below.</string>
    <string name="status_auto_open">Open accessibility settings</string>
    <string name="status_manual_title">By hand</string>
    <string name="status_tidy_title">Tidy the status bar</string>
    <string name="status_tidy_note">Android can hide some status bar icons, but only from a computer. Pick the icons to hide, copy the command and run it with adb (USB debugging on). Uno cannot change this itself.</string>
    <string name="status_tidy_copy">Copy command</string>
    <string name="status_tidy_reset">To show them all again: %1$s</string>
    <string name="shade_service_description">Allows Uno Launcher’s Home screen gestures to open the system notifications and Quick Settings panels. It also draws the island above other apps so it can be tapped. It does not read screen content or observe activity in other apps.</string>


