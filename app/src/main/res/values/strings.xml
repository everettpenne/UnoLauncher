    <!-- What's new (WhatsNew.kt): rewrite these with each release -->
    <string name="whats_new_title">What\'s new in Uno %1$s</string>
    <string name="whats_new_done">Got it</string>
    <string name="whats_new_1">Long-press the island for a card made for what is live: music, a call, a timer, a stopwatch, a Live Update or navigation.</string>
    <string name="whats_new_2">Home is more like iOS: a seven-row grid, a menu when you hold an app, iOS-style folders, and Card or Glass widgets.</string>
    <string name="whats_new_3">The island has a Playful theme, on by default, with rolling digits, wavy progress and a liquid battery. Island settings can turn it to Calm.</string>
    <string name="whats_new_4">The App Library has a frosted look that scrolls more smoothly, and the welcome sheet is a five-step setup.</string>
    <!-- Island theme sharing as text -->
